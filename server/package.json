{
  "name": "@xuxing/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "续行 K0 Web 车道 A：Hono 服务端（与内核同进程），HTTP API + SSE 实时通道 + 提议层（magpie 网关，可降级）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/server/src/main.js",
    "seed": "npm run build && node dist/server/src/seed/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
